# Generate with: openssl rand -hex 32 ; KEEP THIS VALUE SAFE FOR DB RESTORES
APP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Local development; for Cloudflare deployment use https://rooms.example.com and true
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_SECURE=false
DATABASE_URL=sqlite:///data/reservations.db
BIND_ADDR=0.0.0.0:3000
CTU_BASE_URL=https://libapp.ctu.edu.vn/dkptl
SCHEDULE_REFRESH_SECONDS=120
SEED_SNAPSHOT=true

# Optional private notifications; create a Telegram bot using BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional deployment: Dashboard > Zero Trust > Networks > Tunnels > Create tunnel
CLOUDFLARE_TUNNEL_TOKEN=
RUST_LOG=info
